{
    "name": "flarum/realtime",
    "description": "Step up to make your Flarum forum realtime.",
    "keywords": [
        "extension",
        "flarum",
        "realtime",
        "typing indicator",
        "websocket"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/flarum/framework/issues",
        "source": "https://github.com/flarum/pusher",
        "forum": "https://discuss.flarum.org"
    },
    "homepage": "https://flarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://flarum.org/donate/"
        }
    ],
    "type": "flarum-extension",
    "authors": [
        {
            "name": "Daniël Klabbers",
            "email": "daniel@klabbers.email",
            "homepage": "https://luceos.com/"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0-beta",
        "plesk/ratchetphp": "v1.0.4",
        "pusher/pusher-php-server": "^7.2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Realtime",
            "category": "feature",
            "icon": {
                "image": "resources/assets/logo.svg",
                "backgroundColor": "#E3E7F1",
                "backgroundSize": "100%",
                "backgroundRepeat": "no-repeat",
                "backgroundPosition": "center"
            },
            "optional-dependencies": [
                "clarkwinkelmann/flarum-ext-first-post-approval",
                "flarum/approval",
                "flarum/flags",
                "flarum/lock",
                "flarum/subscriptions",
                "fof/follow-tags",
                "fof/gamification",
                "fof/reactions"
            ]
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Flarum\\Realtime\\": "src/"
        }
    },
    "conflict": {
        "flarum/pusher": "*",
        "kyrne/websocket": "*"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis"
    },
    "require-dev": {
        "fof/best-answer": "^2.0.0-beta",
        "flarum/lock": "^2.0.0-beta",
        "flarum/likes": "^2.0.0-beta",
        "flarum/flags": "^2.0.0-beta",
        "fof/reactions": "^2.0.0-beta",
        "flarum/phpstan": "^2.0.0-beta",
        "flarum/testing": "^2.0.0-beta",
        "flarum/messages": "^2.0.0-beta",
        "fof/discussion-views": "^2.0.0-beta"
    },
    "minimum-stability": "beta"
}
