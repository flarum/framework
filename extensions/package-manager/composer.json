{
    "name": "flarum/extension-manager",
    "description": "Install, update and roll back extensions and Flarum itself from the admin panel, on any host including shared hosting. Every step is a checkpoint, so an interrupted update loses progress, never the site.",
    "keywords": [
        "extensions",
        "composer",
        "packages",
        "manager",
        "updater",
        "rollback"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Flarum",
            "email": "info@flarum.org",
            "homepage": "https://flarum.org/team"
        }
    ],
    "support": {
        "issues": "https://github.com/flarum/framework/issues",
        "source": "https://github.com/flarum/extension-manager"
    },
    "require": {
        "flarum/core": "^2.1",
        "composer/composer": "^2.7"
    },
    "require-dev": {
        "flarum/testing": "^2.1"
    },
    "replace": {
        "ernestdefoe/millwright": "*"
    },
    "extra": {
        "flarum-extension": {
            "title": "Extension Manager",
            "icon": {
                "name": "fas fa-box-open",
                "backgroundColor": "#117187",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "excludeScaffolding": [
                ".github/workflows/backend.yml",
                "js/src/admin/index.ts",
                "tests/phpunit.integration.xml"
            ],
            "modules": {
                "admin": true,
                "forum": false,
                "js": true,
                "jsCommon": false,
                "css": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Flarum\\ExtensionManager\\": "src/"
        },
        "files": [
            "bootstrap/web-reset.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Flarum\\ExtensionManager\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:unit:filter": "phpunit -c tests/phpunit.unit.xml --filter",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:unit:filter": "Runs unit tests whose name matches: composer test:unit:filter -- ClassName",
        "test:integration": "Runs all integration tests.",
        "test:integration:filter": "Runs integration tests whose name matches: composer test:integration:filter -- ClassName",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ]
}
