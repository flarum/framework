{
    "name": "flarum/ideation",
    "description": "Feature requests for Flarum: members post ideas and vote for them, moderators move them across a roadmap, and voters hear when an idea ships.",
    "type": "flarum-extension",
    "keywords": [
        "ideation",
        "roadmap",
        "feature requests",
        "voting"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/flarum/framework/issues",
        "source": "https://github.com/flarum/ideation",
        "forum": "https://discuss.flarum.org"
    },
    "homepage": "https://flarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://flarum.org/donate/"
        }
    ],
    "require": {
        "flarum/core": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Flarum\\Ideation\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "flarum-extension": {
            "title": "Ideation",
            "category": "feature",
            "optional-dependencies": [
                "flarum/tags"
            ],
            "icon": {
                "name": "fas fa-map-signs",
                "backgroundColor": "#4d698e",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Flarum\\Ideation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:unit:filter": "phpunit -c tests/phpunit.unit.xml --filter",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:unit:filter": "Runs unit tests whose name matches: composer test:unit:filter -- ClassName",
        "test:integration": "Runs all integration tests.",
        "test:integration:filter": "Runs integration tests whose name matches: composer test:integration:filter -- ClassName",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "require-dev": {
        "flarum/tags": "*@dev",
        "flarum/testing": "^2.1"
    }
}
